<Window x:Class="FileDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileDownload"
        mc:Ignorable="d"
        Title="File Download" Height="900" Width="1500" Background="#434343">
    <Window.Resources>
        <!--<local:AppIDList x:Key="AppIDList"/>
        <local:DocTypeList x:Key="DocTypeList"/>-->
        <Style x:Key="WrappedColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Text="{Binding}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MyButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <!-- Background="#FD7BE0F0" -->
                        <!-- BorderBrush="#FF7BE0F0" -->
                        <Border x:Name="border" 
                         BorderThickness="1"
                         Padding="4,2" 
                         BorderBrush="#5a4bad"
                         Background="#5a4bad" 
                         
                         CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#978cd4" />
                                <Setter TargetName="border" Property="Background" Value="#978cd4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" Value="#FFE6F3F5"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <CollectionViewSource x:Key="ItemsCVS" Source="{Binding LawType}" />
    </Window.Resources>
    <Grid x:Name="MainGrid" Height="Auto">
        <StackPanel Orientation="Horizontal" Height="{Binding ElementName=MainGrid, Path=ActualHeight}">
            <!--Excel:ExcelActions.EnabledCopyExcel="True" Excel:ExcelActions.EnabledPasteExcel="True"-->
            <StackPanel>
                <TextBlock Text="REQUEST ID" Height="25" TextWrapping="Wrap" Width="138" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxRequestId" HorizontalAlignment="Left" Height="25" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" TextChanged="BoxNID_TextChanged" />

                <TextBlock Text="STUDENT ID" Margin="0 25 0 0" Height="25" TextWrapping="Wrap" Width="138" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxStudentId" HorizontalAlignment="Left" Height="25" IsReadOnly="True"  Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="LRAP ID" Margin="0 25 0 0" Height="25" TextWrapping="Wrap" Width="138" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxLrapId" HorizontalAlignment="Left" Height="25" IsReadOnly="True"  Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />

                <TextBlock Text="STUDENT NAME" Margin="0 25 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxStudentName" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />

                <Button x:Name ="btnDownloadDocument" Content="Download Document(s)" HorizontalAlignment="Left" Height="50" Margin="0 25 0 0" Tag = "1" VerticalAlignment="Top" Width="198" Style="{StaticResource MyButtonStyle}"  FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Download Documents highlighted in the grid." ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="10000" Click="BtnDownloadDocument_Click" />
                <Button x:Name ="btnDownloadAllDocument" Content="Download All Documents" HorizontalAlignment="Left" Height="50" Margin="0 25 0 0" Tag = "1" VerticalAlignment="Top" Width="198" Style="{StaticResource MyButtonStyle}"  FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Download All Documents for this Participant." ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="10000" Click="BtnDownloadAllDocument_Click" />

                <TextBlock Text="Is Third Party" Margin="0 50 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxThirdParty" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />

                <!--<TextBlock Text="Status Update" Height="25" TextWrapping="Wrap" Width="138" Margin="0 25 0 0" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <ComboBox x:Name ="boxStatus" HorizontalAlignment="Center" Height="25" Margin="0 5 0 0" VerticalAlignment="Top" Width="176" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16">
                    <ComboBoxItem>In Progress</ComboBoxItem>
                    <ComboBoxItem>Submitted</ComboBoxItem>
                    <ComboBoxItem>Waiting On</ComboBoxItem>
                    <ComboBoxItem>In QC</ComboBoxItem>
                    <ComboBoxItem>Approved</ComboBoxItem>
                    <ComboBoxItem>Ineligible</ComboBoxItem>
                    <ComboBoxItem>Paid</ComboBoxItem>
                    <ComboBoxItem>Inactive</ComboBoxItem>
                    <ComboBoxItem>Incomplete</ComboBoxItem>
                    <ComboBoxItem>Closed</ComboBoxItem>
                    <ComboBoxItem>Cancelled</ComboBoxItem>
                    
                </ComboBox>
                <Button x:Name ="btnUpdateStatus" Content="Update Status" HorizontalAlignment="Left" Height="50" Margin="0 15 0 0" Tag = "1" VerticalAlignment="Top" Width="198" Style="{StaticResource MyButtonStyle}"  FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Download All Documents for this Participant." ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="10000" Click="btnUpdateStatus_Click" />-->

                <!--<Button x:Name ="btnAdminLink" HorizontalAlignment="Left" Height="31" Margin="0 10 0 0" Tag = "1" VerticalAlignment="Top" Width="176" Style="{StaticResource MyButtonStyle}" FontSize="14">
                    -->
                <!--Hyperlink NavigateUri="https://nyulaw.mylrap.org/App/Participants?nyuid= " RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="{x:Null}" Foreground="White"!-->
                <!--
                    <Hyperlink NavigateUri="https://nyu-law-rap-dev.azurewebsites.net/App/Participants?nyuid=" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="{x:Null}" Foreground="White">
                        <Run Text="Admin Page"/>
                    </Hyperlink>
                </Button>-->
                <!--<TextBlock Text="FILTERS:" HorizontalAlignment="Left" Height="25" Margin="0 40 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="116" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>

                <TextBlock Text="App ID" HorizontalAlignment="Left" Height="25" Margin="0 20 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="108" FontSize="19" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <ComboBox x:Name ="boxAppIDs" IsEditable = "False" RenderTransformOrigin="0.397,0.487" Margin="0 10 0 0" HorizontalAlignment="Left" Width="198" VerticalAlignment="Top" Height="30" FontSize="14" ItemsSource="{StaticResource AppIDList}" SelectionChanged="BoxAppIDs_SelectionChanged"/>

                <TextBlock Text="Document Type" HorizontalAlignment="Left" Height="25" Margin="0 20 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="159" FontSize="19" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <ComboBox x:Name ="boxDocTypes" IsEditable = "False" RenderTransformOrigin="0.397,0.487" Margin="0 10 0 0" HorizontalAlignment="Left" Width="198" VerticalAlignment="Top" Height="30" FontSize="14" ItemsSource="{StaticResource DocTypeList}" SelectionChanged="BoxDocTypes_SelectionChanged"/>-->
                <!--<Button x:Name ="btnUploadDocument" Content="Upload Document" HorizontalAlignment="Left" Height="48" Margin="0 30 0 0" Tag = "1" VerticalAlignment="Top" Width="198" Style="{StaticResource MyButtonStyle}"  FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="See information contained on the calculation table for this participant. Will give insight to previous calculations." ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="10000" Click="BtnUploadDocument_Click"/>-->
                
                
                <Button x:Name ="btnApprovalProcess" 
                        Content="Approval Process" 
                        HorizontalAlignment="Left" Height="50" Margin="0 150 0 0" 
                        Tag = "1" VerticalAlignment="Top" Width="198" 
                        Style="{StaticResource MyButtonStyle}"  FontSize="16" 
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                        ToolTip="Open Approval Process Window" 
                        ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="10000" 
                        Click="btnApprovalProcess_Click"
                        IsEnabled="True"/>

            </StackPanel>
            <!--Excel:ExcelActions.EnabledCopyExcel="True" Excel:ExcelActions.EnabledPasteExcel="True"-->
            <StackPanel VerticalAlignment="Stretch" Margin="35 0 0 0" >
                <TextBlock Text="Address" Margin="0 0 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxStudentAddress" HorizontalAlignment="Stretch" Height="25"  IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />

                <TextBlock Text="Household" Margin="0 0 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxStudentHousehold" HorizontalAlignment="Stretch" Height="25"  IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />

                <StackPanel Orientation="Horizontal"/>

                <DataGrid x:Name="DocDataGrid" 
                    IsSynchronizedWithCurrentItem="True" CanUserAddRows="False"  IsReadOnly="True" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" AutoGenerateColumns="False" 
                          Height="600" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Doc ID" Binding="{Binding DocId}"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Modified}"/>
                        <DataGridTextColumn Header="File Name" Binding="{Binding BlobFilename}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Margin="25 0 0 0">
                <DataGrid x:Name="EmpGrid" 
    IsSynchronizedWithCurrentItem="True" CanUserAddRows="False"  IsReadOnly="True" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" AutoGenerateColumns="False" 
          Height="Auto" SelectedCellsChanged="EmpGrid_SelectedCellsChanged" SelectionMode ="Extended" SelectionUnit="CellOrRowHeader">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}"/>
                        <DataGridTextColumn Header="Emp Name" Binding="{Binding EmployerName}"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding JobTitle}"/>
                        <DataGridTextColumn Header="Is Spouse?" Binding="{Binding IsSpouse}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Employer Name" HorizontalAlignment="Left" Margin="0 10 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxEmpName" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="Title" HorizontalAlignment="Left" Margin="0 10 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxTitle" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="Weekly Hours" HorizontalAlignment="Left" Margin="0 10 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxHours" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="Income Type" HorizontalAlignment="Left" Margin="0 10 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxIncomeType" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="Expected Annual Income" HorizontalAlignment="Left" Margin="0 10 0 0" Height="27" TextWrapping="Wrap" Width="237" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxAnnualIncome" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="City" Margin="0 10 0 0" HorizontalAlignment="Left" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxCity" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="State" Margin="0 10 0 0" HorizontalAlignment="Left" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxState" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="Start Date" HorizontalAlignment="Left" Margin="0 10 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxStartDate" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="End Date" HorizontalAlignment="Left" Margin="0 10 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxEndDate" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />
                <TextBlock Text="Own Business" HorizontalAlignment="Left" Margin="0 10 0 0" Height="25" TextWrapping="Wrap" Width="180" FontSize="22" FontFamily="Times New Roman" FontWeight="Bold" Foreground="#FFF0F0F0"/>
                <TextBox x:Name ="boxOwnBusiness" HorizontalAlignment="Left" Height="25" IsReadOnly="True" Margin="0 5 0 0" TextWrapping="Wrap" VerticalAlignment="Top" Width="Auto" FontFamily="Times New Roman" BorderBrush="Black" FontSize="16" />

            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
