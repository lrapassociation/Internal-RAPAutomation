<Window x:Class="FileDownload.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:FileDownload"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Title="ApprovalWindow" Background="#434343">
    <Window.Resources>
        <Style x:Key="BoolCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Text" Value=""/>
            <Setter Property="Foreground" Value="Black"/>

            <Style.Triggers>
                <!-- TRUE = green check -->
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Text" Value="✔"/>
                    <Setter Property="Foreground" Value="Green"/>
                </DataTrigger>

                <!-- FALSE = red X -->
                <DataTrigger Binding="{Binding}" Value="False">
                    <Setter Property="Text" Value="✖"/>
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid>
        <StackPanel Orientation="Horizontal">

            <StackPanel Margin="10,10,0,0">
                <DataGrid x:Name="ExcelDataGrid" 
                            IsSynchronizedWithCurrentItem="True" 
                            CanUserAddRows="False"  IsReadOnly="True" 
                            AutoGenerateColumns="False" 
                            HorizontalAlignment="Left" VerticalAlignment="Top" 
                            Height="Auto" MaxHeight="200"
                            SelectedCellsChanged="ExcelGrid_SelectedCellsChanged" 
                            SelectionMode ="Single" SelectionUnit="Cell">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Margin="0 20 0 0">
                    <TextBlock x:Name="DataLoadingText" Text="Loading Data..." FontSize="14" Foreground="Yellow"/>
                    <TextBlock x:Name="DataErrorText" Text="Data Error" FontSize="14" Foreground="Red" Visibility="Collapsed"/>
                    <TextBlock x:Name="DataReadyText" Text="List Data Ready" FontSize="14" Foreground="LightGreen" Visibility="Collapsed"/>

                    <ProgressBar Name="LoadingBar" Value="0" Maximum="100" 
                                 Width="175" Margin="0 5 0 0"
                                 HorizontalAlignment="Left">
                        <ProgressBar.Style>
                            <Style TargetType="{x:Type ProgressBar}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                                            <Grid Height="10" MinWidth="50" Background="{TemplateBinding Background}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Determinate" />
                                                        <VisualState x:Name="Indeterminate">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Duration="00:00:00"
                                                                               Storyboard.TargetName="PART_Indicator"
                                                                               Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                                        <DiscreteObjectKeyFrame.Value>
                                                                            <SolidColorBrush>Transparent</SolidColorBrush>
                                                                        </DiscreteObjectKeyFrame.Value>
                                                                    </DiscreteObjectKeyFrame>
                                                                </ObjectAnimationUsingKeyFrames>

                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="PART_Track" CornerRadius="4" BorderThickness="1"
                                                        BorderBrush="Black">
                                                </Border>

                                                <Border CornerRadius="4" BorderThickness="1" x:Name="PART_Indicator"
                                                        HorizontalAlignment="Left" Background="LimeGreen"
                                                        BorderBrush="Black"
                                                        Margin="0,0,0,0">
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="LimeGreen" />
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>



                <DataGrid ItemsSource="{Binding}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="All"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Margin="0 10 0 0"
                          Height="Auto">


                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Table" Binding="{Binding Header}" Width="Auto" />

                        <DataGridTemplateColumn Header="Tracker">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Bind DataContext to C1, style does the rest -->
                                    <TextBlock Style="{StaticResource BoolCellStyle}"
                                   DataContext="{Binding C1}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Approval">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BoolCellStyle}"
                                   DataContext="{Binding C2}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Payment">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BoolCellStyle}"
                                   DataContext="{Binding C3}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ex Gratia">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BoolCellStyle}"
                                   DataContext="{Binding C4}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Historical">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BoolCellStyle}"
                                    DataContext="{Binding C5}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="StudentDataStack"
                            Visibility="Collapsed"
                            Margin="0 24 0 0">
                    <TextBlock x:Name="StudentDataLoadingText" Text="Loading Student Data..." FontSize="14" Foreground="Yellow"/>
                    <TextBlock x:Name="StudentDataErrorText" Text="Data Error" FontSize="14" Foreground="Red" Visibility="Collapsed"/>
                    <TextBlock x:Name="StudentDataReadyText" Text="Student Data Ready" FontSize="14" Foreground="LightGreen" Visibility="Collapsed"/>

                    <ProgressBar Name="StudentLoadingBar" Value="0" Maximum="100" 
                                 Width="175" Margin="0 5 0 0"
                                 HorizontalAlignment="Left">
                        <ProgressBar.Style>
                            <Style TargetType="{x:Type ProgressBar}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                                            <Grid Height="10" MinWidth="50" Background="{TemplateBinding Background}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Determinate" />
                                                        <VisualState x:Name="Indeterminate">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Duration="00:00:00"
                                                                               Storyboard.TargetName="PART_Indicator"
                                                                               Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                                        <DiscreteObjectKeyFrame.Value>
                                                                            <SolidColorBrush>Transparent</SolidColorBrush>
                                                                        </DiscreteObjectKeyFrame.Value>
                                                                    </DiscreteObjectKeyFrame>
                                                                </ObjectAnimationUsingKeyFrames>

                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="PART_Track" CornerRadius="4" BorderThickness="1"
                                                        BorderBrush="Black">
                                                </Border>

                                                <Border CornerRadius="4" BorderThickness="1" x:Name="PART_Indicator"
                                                        HorizontalAlignment="Left" Background="LimeGreen"
                                                        BorderBrush="Black"
                                                        Margin="0,0,0,0">
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="LimeGreen" />
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <StackPanel x:Name="StudentBtnStack" Visibility="Collapsed">
                        <Button x:Name ="btnRAPCalc" Content="RAP Calculator" 
                            HorizontalAlignment="Left"  Margin="0 8 0 0" Tag = "1" 
                            VerticalAlignment="Top"
                            Height="40" Width="172"
                            FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnRAPCalc_Click" 
                            />
                        <Button x:Name ="btnRAPSummary" Content="RAP Summary" 
                            HorizontalAlignment="Left"  Margin="0 16 0 0" Tag = "1" 
                            VerticalAlignment="Top" Height="40" Width="172" 
                            FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnRAPSummary_Click" 
                            />
                        <Button x:Name ="btnRAPClosing" Content="Closing" 
                            HorizontalAlignment="Left" Margin="0 16 0 0" Tag = "1" 
                            VerticalAlignment="Top" Height="40" Width="172"
                            FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnRAPClosing_Click" 
                            />
                        <Button x:Name ="btnRAPApproval" Content="RAP Approval" 
                            HorizontalAlignment="Left" Margin="0 16 0 0" Tag = "1" 
                            VerticalAlignment="Top" Height="40" Width="172" 
                            FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnRAPApproval_Click" 
                            />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            
            <StackPanel x:Name="RapCalculatorStack"
                        Visibility="Collapsed"
                        Orientation="Horizontal">
                <StackPanel>
                    <DataGrid x:Name="RapCalculatorGrid"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                              HorizontalAlignment="Left"
                            Margin="12">
                    </DataGrid>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="RapSummaryStack"
                        Visibility="Collapsed"
                        Orientation="Horizontal">
                <StackPanel>
                    <DataGrid x:Name="RapSummaryGrid"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                              HorizontalAlignment="Left"
                                Margin="12">
                    </DataGrid>
                </StackPanel>
                
            </StackPanel>
            <StackPanel x:Name="ClosingStack"
                        Visibility="Collapsed"
                        Orientation="Horizontal">
                <StackPanel>
                    <DataGrid x:Name="PaymentsGrid"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                Margin="12">
                    </DataGrid>
                    
                    <DataGrid x:Name="ExGratiaGrid"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                Margin="12">
                    </DataGrid>
                </StackPanel>
                <StackPanel>
                    <DataGrid x:Name="RapTrackerGrid"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                              HorizontalAlignment="Left"
                                Margin="12">
                    </DataGrid>
                </StackPanel>

            </StackPanel>

            <StackPanel x:Name="RapApprovalStack"
                        Visibility="Collapsed"
                        Orientation="Horizontal">

                <wv2:WebView2 x:Name="PdfWebView"
              Width="1000"
              Height="1200"/>

            </StackPanel>
            <StackPanel x:Name="QuarterInteractionStack">
                <TextBlock Text="Quarters"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="Quarter1Box" HorizontalAlignment="Left" SelectionChanged="Quarter1_SelectionChanged">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                    </ComboBox>
                    <ComboBox x:Name="Quarter2Box" HorizontalAlignment="Left" Margin="15 0 0 0" Visibility="Collapsed" SelectionChanged="Quarter2_SelectionChanged"/>
                    <ComboBox x:Name="Quarter3Box" HorizontalAlignment="Left" Margin="15 0 0 0" Visibility="Collapsed" SelectionChanged="Quarter3_SelectionChanged"/>
                    <ComboBox x:Name="Quarter4Box" HorizontalAlignment="Left" Margin="15 0 0 0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel x:Name="RAPCalculatorBtns">
                    <Button x:Name ="btnHistoricalInsert" Content="Insert Historical Data" 
                            HorizontalAlignment="Left"  Margin="0 8 0 0" 
                            VerticalAlignment="Top"
                            Height="40" Width="128"
                            FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnHistoricalInsert_Click" 
                            />
                    <Button x:Name ="btnPaymentsInsert" Content="Insert Payments Data" 
                            HorizontalAlignment="Left"  Margin="0 8 0 0" 
                            VerticalAlignment="Top"
                            Height="40" Width="128"
                            FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnPaymentsInsert_Click" 
                            />
                    <Button x:Name ="btnRAPTrackerInsert" Content="Insert RAP Tracker" 
                            HorizontalAlignment="Left"  Margin="0 8 0 0" 
                            VerticalAlignment="Top"
                            Height="40" Width="128"
                            FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnRAPTrackerInsert_Click" 
                            />
                    <Button x:Name ="btnExGratia" Content="Insert Ex Gratia" 
                            HorizontalAlignment="Left"  Margin="0 8 0 0" 
                            VerticalAlignment="Top"
                            Height="40" Width="128"
                            FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnExGratia_Click" 
                            />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        
    </Grid>
</Window>
